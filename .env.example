# Browser-visible Clerk key. Use a production Clerk instance for public deployments.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Server-only secret. Configure it in the hosting provider; never expose it to browser code.
CLERK_SECRET_KEY=sk_live_your_server_secret

# Optional hosted GenAI evaluator configuration.
CODECRAFT_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CODECRAFT_AI_REVIEW_DAILY_LIMIT=3
CODECRAFT_GENAI_REQUESTS_PER_MINUTE=12

# Comma-separated Clerk user IDs or email addresses allowed to view /admin/analytics.
CODECRAFT_ADMIN_USER_IDS=user_your_clerk_user_id
CODECRAFT_ADMIN_EMAILS=owner@example.com

# Wrangler database name for npm run db:export and db:restore.
CODECRAFT_D1_DATABASE=your-production-d1-database-name
